# Secret Key for session signing
SECRET_KEY=change_this_to_a_random_secure_secret_key_12345

# Application Base URL (for OAuth Callbacks)
APP_URL=http://localhost:8000

# Open-Source Cloud LLM Provider Options
# Provider choices: "openrouter", "groq", "openai", "gemini"
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Default AI Model
# Examples for OpenRouter: "qwen/qwen-2.5-coder-32b-instruct", "meta-llama/llama-3.3-70b-instruct", "deepseek/deepseek-r1", "google/gemini-2.0-flash-001"
# Examples for Groq: "llama-3.3-70b-versatile", "qwen-2.5-coder-32b"
# Examples for OpenAI: "gpt-4o-mini"
DEFAULT_MODEL=qwen/qwen-2.5-coder-32b-instruct

# OAuth Provider Credentials
# Google OAuth setup: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# GitHub OAuth setup: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Developer Bypass / Guest Mode (Set to "true" to allow instant guest login without OAuth keys during dev)
ALLOW_GUEST_LOGIN=true
